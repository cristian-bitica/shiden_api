# Environment: local | databricks
ENVIRONMENT=local

# Storage — local Delta Lake base path
DELTA_BASE_PATH=./data/delta

# ENTSO-E Transparency Platform API key
# Register at: https://transparency.entsoe.eu/
ENTSOE_API_KEY=your-api-key-here

# API server
API_HOST=0.0.0.0
